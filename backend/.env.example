# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Database Configuration
# Use PostgreSQL by default. If PostgreSQL is not installed/running, SQLite fallback is supported:
# DATABASE_URL=sqlite:///./hazard_db.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/hazard_db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Hazard Thresholds Configuration
# Flood Thresholds (Water level in cm)
WATER_LEVEL_MODERATE_CM=35.0
WATER_LEVEL_HIGH_CM=50.0
WATER_LEVEL_CRITICAL_CM=75.0

# Forest Fire Thresholds
FIRE_TEMP_THRESHOLD_C=38.0
FIRE_HUMIDITY_THRESHOLD_PCT=25.0
FIRE_SMOKE_THRESHOLD_PPM=45.0

# Air Quality Thresholds (AQI)
AQI_MODERATE=100.0
AQI_UNHEALTHY=200.0
AQI_HAZARDOUS=300.0

# General Smoke Thresholds (ppm)
SMOKE_ELEVATED_PPM=30.0
SMOKE_CRITICAL_PPM=60.0

# Auto Simulation on Startup
AUTO_START_SIMULATION=true
SIMULATION_INTERVAL_SECONDS=4
